# All variables below are browser-public. Never put secrets here.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional. Must serve the selected cluster (getGenesisHash is verified).
NEXT_PUBLIC_SOLANA_RPC_URL=
# Reserved for a future subscription adapter; not used by current polling.
NEXT_PUBLIC_SOLANA_WS_URL=
# Financial features cannot be enabled by environment variables: Devnet
# execution and the Mainnet lock live in src/config/retry-protocol.ts.
# These legacy flags may only be absent or "false".
NEXT_PUBLIC_ENABLE_LIVE_TRADING=false
NEXT_PUBLIC_ENABLE_TOKEN_LAUNCH=false
# Public URL of RETRY's metadata host (infra/metadata-worker). Without it the
# Create flow cannot launch, because token metadata would have nowhere to live.
NEXT_PUBLIC_RETRY_METADATA_URL=
# GitHub Pages builds set this to /launchpadlendaria.
NEXT_PUBLIC_BASE_PATH=

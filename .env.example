# All variables below are browser-public. Never put secrets here.
NEXT_PUBLIC_DEFAULT_NETWORK=base-sepolia
# Optional public RPC endpoints; official chain defaults are used otherwise.
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
# Optional: enables the WalletConnect connector. Obtain an ID from Reown.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# @retry/web3 environment for the RETRY Next.js app.
# These are the same names the Stage 1 app already uses (see the root .env.example).
# Everything prefixed NEXT_PUBLIC_ ends up in the browser bundle: never put secrets here.

# Network the app targets: base-sepolia (development, default) or base (production).
NEXT_PUBLIC_DEFAULT_NETWORK=base-sepolia

# Optional dedicated RPC endpoints (https only; http allowed for localhost).
# Empty = the public, rate-limited Base RPC. A provider key here is public, so
# restrict it to your domains in the provider's dashboard.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=

# Optional WalletConnect (Reown) project ID: 32 hex characters from https://dashboard.reown.com
# Empty or invalid = WalletConnect is listed as "not configured" and no relay connection is made.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

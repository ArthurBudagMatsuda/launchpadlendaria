{
  "name": "@retry/web3",
  "version": "0.1.0",
  "private": true,
  "description": "RETRY Web3 infrastructure: Base networks, EVM wallet connection, network guard and ETH balance (read-only).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "peerDependencies": {
    "@coinbase/wallet-sdk": "^4.3.6",
    "@metamask/connect-evm": "^2.1.0",
    "@tanstack/react-query": "^5.90.0",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "viem": "^2.57.0",
    "wagmi": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@coinbase/wallet-sdk": "4.4.0",
    "@metamask/connect-evm": "2.1.1",
    "@tanstack/react-query": "5.105.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@walletconnect/ethereum-provider": "2.26.0",
    "jsdom": "29.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "viem": "2.57.11",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wagmi": "3.7.9"
  }
}

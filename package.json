{
  "name": "retry-launchpad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm web3:build && next dev --hostname 127.0.0.1",
    "build": "pnpm web3:build && next build",
    "build:pages": "pnpm web3:build && node scripts/build-pages.mjs",
    "preview:pages": "node scripts/serve-pages.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm web3:build && next typegen && tsc --noEmit",
    "test": "pnpm web3:build && vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web3:build": "pnpm --filter @retry/web3 build"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "4.3.6",
    "@metamask/connect-evm": "^2.1.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@retry/web3": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.57.11",
    "wagmi": "^3.7.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}

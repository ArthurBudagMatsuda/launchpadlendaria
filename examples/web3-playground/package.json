{
  "name": "retry-web3-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Vite app to exercise @retry/web3 with real wallets on Base Sepolia / Base.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "4.3.6",
    "@metamask/connect-evm": "2.1.1",
    "@tanstack/react-query": "5.104.5",
    "@walletconnect/ethereum-provider": "2.26.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.11",
    "wagmi": "3.7.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}

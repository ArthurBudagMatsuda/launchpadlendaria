# RETRY Web3 playground. Copy to .env.local and fill in what you have.
# These values end up in the browser bundle: never put secrets here.

# base-sepolia (recommended for development) or base
VITE_DEFAULT_NETWORK=base-sepolia

# Optional dedicated RPC endpoints (https). Empty = rate-limited public Base RPC.
# Use keys restricted to your domain: anything VITE_/NEXT_PUBLIC_ is public.
VITE_BASE_SEPOLIA_RPC_URL=
VITE_BASE_RPC_URL=

# Optional WalletConnect / Reown project ID (32 hex chars) from https://dashboard.reown.com
# Empty = WalletConnect shows as "not configured".
VITE_WALLETCONNECT_PROJECT_ID=
